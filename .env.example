# LegalEase — Frontend Environment Variables
#
# Copy this file to `.env.local` and fill in the actual values.

# Backend API URL (local dev default)
VITE_API_URL=http://localhost:8000

# Cognito — same pool as backend, but accessed from the client
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-app-client-id-here
VITE_AWS_REGION=us-east-1
